{
  "name": "bar-pos-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev:all",
    "dev:all": "concurrently -k -p \"[{name}]\" -n \"BACKEND,CUSTOMER,APP\" -c \"blue,green,magenta\" \"npm run dev:backend\" \"npm run dev:customer\" \"npm run dev:pos\"",
    "dev:backend": "npm run --workspace=backend dev",
    "dev:customer": "npm run --workspace=apps/customer dev",
    "dev:pos": "npm run --workspace=apps/pos dev",
    "dev:app": "npm run --workspace=apps/pos dev",
    "dev:admin": "npm run --workspace=apps/admin dev",
    "electron:dev": "npm run --workspace=apps/pos electron:dev",
    "electron:pack": "npm run --workspace=apps/pos electron:pack",
    "electron:dist": "npm run --workspace=apps/pos electron:dist",
    "build": "npm run --workspace=backend build",
    "start": "node backend/dist/server.js",
    "build:all": "npm run --workspace=backend build && npm run --workspace=apps/customer build && npm run --workspace=apps/pos build",
    "db:init": "npm run --workspace=backend db:init",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
